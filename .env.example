PORT=3001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/zerodash-0g

# JWT Auth (shared with game client)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BROWSER_JWT_SECRET=replace_with_32_byte_hex_secret

# ── 0G Mainnet (chainId 16661) ───────────────────────────────────────────────
# Used by: Storage uploads/downloads, Chain anchoring, Contract deployment
OG_MAINNET_RPC=https://evmrpc.0g.ai
OG_MAINNET_CHAIN_ID=16661

# 0G Storage indexer — mainnet node
ZG_INDEXER_RPC=https://indexer-storage-turbo-v2.0g.ai

# PlayerSaveAnchor contract — deploy on mainnet: npm run deploy:anchor
ZG_ANCHOR_CONTRACT_ADDRESS=0x_SET_AFTER_DEPLOY

# Backend operator wallet — signs storage uploads + anchorSave transactions
# This address becomes the immutable backendOperator in the contract
# NOTE: rotating this key requires redeploying PlayerSaveAnchor (backendOperator is immutable)
ZG_PRIVATE_KEY=0x_your_backend_operator_private_key

# ── 0G DA — Testnet ONLY (DA not available on mainnet yet) ───────────────────
ZG_DA_DISPERSER=disperser-testnet.0g.ai:51001

# ── 0G Compute anti-cheat (mainnet API, optional) ────────────────────────────
# Leave blank to skip anti-cheat entirely. Get a key at https://pc.0g.ai
ZG_COMPUTE_API_KEY=

# ── Master switch — false disables all 0G ops without breaking anything else ──
ZG_ENABLED=true

# ── Existing 0G Mainnet contracts (chainId 16661) ────────────────────────────
PRIVATE_KEY=0x_your_session_leaderboard_wallet_private_key
SESSION_CONTRACT_ADDRESS=0x9D8090A0D65370A9c653f71e605718F397D1B69C
LEADERBOARD_CONTRACT_ADDRESS=0x_set_after_deploy

# ── Ownership rotation (run: npm run transfer-ownership) ─────────────────────
# Fill these in ONLY when rotating a compromised wallet.
# CONTRACT_ADDRESS must implement owner() + transferOwnership() (OpenZeppelin Ownable).
# For PlayerSaveAnchor (ZG_ANCHOR_CONTRACT_ADDRESS) — use npm run deploy:anchor instead.
OLD_PRIVATE_KEY=0x309b5ca4e4a8894cc034a21900eaf3ff86ad89200c1317d32d22ce4ce6d91508
NEW_OWNER=0xEAeBE06128Eef723057726cBAe53DdE87F80bcCA
CONTRACT_ADDRESS=0x9D8090A0D65370A9c653f71e605718F397D1B69C
